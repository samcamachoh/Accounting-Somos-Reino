# Copy to .env and fill in. Vite reads these at build time, so
# restart `pnpm dev` after changing them.
#
# Without both values the portals stay in demo mode: they render
# their built-in sample data and never call the network. That is
# the intended state before a database exists.
#
# Everything here is public by design — it is compiled into the
# JavaScript every visitor downloads. Row Level Security in the
# database is what protects the data. NEVER put a database password,
# a connection string, or any secret key (Clerk's sk_…) in a VITE_
# variable; those live only in the serverless function's environment
# (see docs/CLERK.md and README.md).

# The Data API for the PostgreSQL database — a PostgREST-compatible URL
# (Neon's Data API, or PostgREST itself).
VITE_DATA_API_URL=

# Sign-in is Clerk's. The publishable key (pk_test_… / pk_live_…) only
# identifies your Clerk instance; find it in the Clerk dashboard under
# API keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Where the serverless functions (account admin) live.
# Leave blank when they are served from the same site under /api.
VITE_API_URL=
