# Copy to .env and fill in. Vite reads these at build time, so
# restart `pnpm dev` after changing them.
#
# Without both values the portals stay in demo mode: they render
# their built-in sample data and never call the network. That is
# the intended state before a Supabase project exists.
#
# Project Settings -> API in the Supabase dashboard.
# The anon key is safe in the browser; Row Level Security is what
# protects the data. Never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
